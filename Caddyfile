# =========================================================
# HanDdamx2 리버스 프록시 (Caddy)
#
# 역할: 고정 도메인 하나로 들어온 요청을 내부 컨테이너로 라우팅하고,
#       Let's Encrypt 인증서를 자동 발급·갱신해 HTTPS를 제공한다.
#
# 라우팅(단일 도메인 + 경로 기반, CORS 회피):
#   /api/* , /ws/*  → backend  (Spring Boot :8080)
#   그 외 전부       → frontend (nginx 정적 :80)
#
# 도메인은 compose가 넘기는 SITE_DOMAIN 환경변수로 주입한다.
#   예) SITE_DOMAIN=handdam.example.com
#   임시 검증용으로 <OCI공인IP>.sslip.io 같은 값도 그대로 사용 가능(자동 HTTPS 됨).
# =========================================================

{$SITE_DOMAIN} {
	# WebSocket(STOMP 알림/채팅) 및 REST API → 백엔드
	handle /api/* {
		reverse_proxy backend:8080
	}
	handle /ws/* {
		reverse_proxy backend:8080
	}

	# 나머지 모든 경로 → 프론트엔드 정적 서버
	handle {
		reverse_proxy frontend:80
	}

	encode gzip zstd
	log
}
