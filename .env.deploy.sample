# =========================================================
# HanDdamx2 - .env.deploy.sample
# 용도: 공유 dev 서버(OCI)에서 docker-compose.deploy.yml 에 주입하는 값.
# 사용법: OCI 서버의 배포 폴더에 이 파일을 .env.deploy 로 복사한 뒤 값을 채운다.
#         (.env.deploy 는 git에 커밋하지 않는다 — .gitignore 처리됨)
#         cp .env.deploy.sample .env.deploy
#
# 성격: 실제 프로덕션이 아닌 공유 미리보기(local 프로파일). 진짜 비밀값이 아니라
#       팀 공유 테스트값을 넣는다. 그래도 저장소에는 커밋하지 않는다.
# =========================================================

# --- 도메인 (Caddy 자동 HTTPS 대상) ---
# 예: handdam.example.com  또는 임시로 <OCI공인IP>.sslip.io
SITE_DOMAIN=

# --- 배포 이미지 태그 (보통 dev 고정, 롤백 시 특정 git sha로 교체) ---
IMAGE_TAG=dev

# --- PostgreSQL (compose가 DB 컨테이너와 백엔드 양쪽에 사용) ---
POSTGRES_DB=handdam
POSTGRES_USER=handdam
POSTGRES_PASSWORD=handdam1234_local_only

# --- S3 (LocalStack) ---
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=handdam-local
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Google OAuth (local 프로파일도 기본값 없음 → 반드시 채워야 기동됨) ---
# Google Cloud Console에 리다이렉트 URI 등록 필요:
#   https://<SITE_DOMAIN>/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- JWT (공유 서버용 시크릿) ---
JWT_SECRET=change_me_shared_dev_secret
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000

# --- 프론트 base URL (백엔드가 OAuth 성공 리다이렉트 등에 사용) ---
# 위 SITE_DOMAIN 과 동일 도메인으로 채운다. 예: https://handdam.example.com
FRONTEND_BASE_URL=

# --- Email (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Toss Payments (테스트 키) ---
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_API_BASE_URL=https://api.tosspayments.com

# --- Swagger (공유 서버에서는 켜두면 팀 확인에 편리) ---
SWAGGER_ENABLED=true
