# =========================================================
# HanDdamx2 - Root .env.sample
# 용도: docker-compose.yml 변수 치환 전용 (postgres/redis/localstack)
# 사용법: 이 파일을 복사해 .env로 만든 뒤, 실제 값은
#         팀 메신저로 전달받은 값으로 채운다.
#         cp .env.sample .env
# =========================================================

# --- PostgreSQL ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- LocalStack (AWS S3 에뮬레이션) ---
AWS_REGION=ap-northeast-2
LOCALSTACK_PORT=4566
