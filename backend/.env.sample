# =========================================================
# HanDdamx2 - backend/.env.sample
# 용도: Spring Boot 애플리케이션 전용 환경 변수
# 사용법: 이 파일을 복사해 .env로 만든 뒤, 실제 값은
#         팀 메신저로 전달받은 값으로 채운다.
#         cp .env.sample .env
# =========================================================

# --- Spring Profile ---
SPRING_PROFILES_ACTIVE=local

# --- PostgreSQL (root .env의 값과 동일하게 맞출 것) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
JWT_SECRET=
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000

# --- Email (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- AWS S3 (LocalStack) ---
AWS_REGION=ap-northeast-2
AWS_S3_ENDPOINT=http://localhost:4566
AWS_S3_BUCKET=handdam-local
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Toss Payments (Test API) ---
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_API_BASE_URL=https://api.tosspayments.com

# --- Swagger ---
SWAGGER_ENABLED=true
