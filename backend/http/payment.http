@baseUrl = http://localhost:8080
@memberId = 1
@otherMemberId = 9
@creatorId = 2
@selfCreatorId = 1
@missingCreatorId = 999999
@zeroPriceCreatorId = 3
@orderId = HANDDAM_REPLACE_WITH_PREPARE_RESPONSE_ORDER_ID
@paymentKey = REPLACE_WITH_TOSS_SUCCESS_REDIRECT_PAYMENT_KEY
@amount = 15000

### 결제 준비 정상 요청
# 예상: 201 Created
# success=true, data.orderId/customerKey/idempotencyKey 반환
# 프론트는 VITE_TOSS_CLIENT_KEY와 prepare 응답값으로 Toss 결제창을 실행한다.
POST {{baseUrl}}/api/payments/prepare
Content-Type: application/json
X-User-Id: {{memberId}}

{
  "creatorId": {{creatorId}}
}

### 자기 자신 결제
# 예상: 400 Bad Request
# error.code = SELF_SUBSCRIPTION_NOT_ALLOWED
POST {{baseUrl}}/api/payments/prepare
Content-Type: application/json
X-User-Id: {{memberId}}

{
  "creatorId": {{selfCreatorId}}
}

### 존재하지 않는 creator
# 예상: 404 Not Found
# error.code = CREATOR_NOT_FOUND
POST {{baseUrl}}/api/payments/prepare
Content-Type: application/json
X-User-Id: {{memberId}}

{
  "creatorId": {{missingCreatorId}}
}

### 유료 플랜 가격이 0인 creator
# 예상: 400 Bad Request
# error.code = PAID_PLAN_NOT_AVAILABLE
POST {{baseUrl}}/api/payments/prepare
Content-Type: application/json
X-User-Id: {{memberId}}

{
  "creatorId": {{zeroPriceCreatorId}}
}

### 결제 승인 요청 예시
# Toss 결제창 successUrl에서 받은 paymentKey, orderId, amount가 필요하다.
# idempotencyKey는 요청에 넣지 않는다. 서버가 Payment에 저장된 값을 사용한다.
# 예상: 200 OK
# success=true, data.status=SUCCESS, data.subscriptionLevel=PAID
POST {{baseUrl}}/api/payments/confirm
Content-Type: application/json
X-User-Id: {{memberId}}

{
  "paymentKey": "{{paymentKey}}",
  "orderId": "{{orderId}}",
  "amount": {{amount}}
}

### 결제 실패 기록 요청
# Toss failUrl에서 받은 code/message와 prepare 응답의 orderId를 사용한다.
# 예상: 200 OK
# success=true, data.status=FAILED
POST {{baseUrl}}/api/payments/fail
Content-Type: application/json
X-User-Id: {{memberId}}

{
  "orderId": "{{orderId}}",
  "code": "PAY_PROCESS_CANCELED",
  "message": "사용자가 결제를 취소했습니다."
}

### 같은 fail 요청 재호출
# 예상: 200 OK
# FAILED 상태를 멱등 성공으로 반환
POST {{baseUrl}}/api/payments/fail
Content-Type: application/json
X-User-Id: {{memberId}}

{
  "orderId": "{{orderId}}",
  "code": "PAY_PROCESS_CANCELED",
  "message": "사용자가 결제를 취소했습니다."
}

### 존재하지 않는 orderId
# 예상: 404 Not Found
# error.code = PAYMENT_NOT_FOUND
POST {{baseUrl}}/api/payments/fail
Content-Type: application/json
X-User-Id: {{memberId}}

{
  "orderId": "HANDDAM-NOT-FOUND",
  "code": "PAY_PROCESS_CANCELED",
  "message": "사용자가 결제를 취소했습니다."
}

### 다른 회원의 orderId 접근
# 예상: 403 Forbidden
# error.code = PAYMENT_OWNER_MISMATCH
POST {{baseUrl}}/api/payments/fail
Content-Type: application/json
X-User-Id: {{otherMemberId}}

{
  "orderId": "{{orderId}}",
  "code": "PAY_PROCESS_CANCELED",
  "message": "사용자가 결제를 취소했습니다."
}

### 이미 SUCCESS인 결제에 fail 요청
# 예상: 409 Conflict
# error.code = PAYMENT_CONFLICT
POST {{baseUrl}}/api/payments/fail
Content-Type: application/json
X-User-Id: {{memberId}}

{
  "orderId": "{{orderId}}",
  "code": "PAY_PROCESS_CANCELED",
  "message": "성공 결제에 대한 실패 기록 시도"
}
