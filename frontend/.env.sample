# =========================================================
# HanDdamx2 - frontend/.env.sample
# 용도: React(Vite) 애플리케이션 전용 환경 변수
# 사용법: 이 파일을 복사해 .env로 만든 뒤, 실제 값은
#         팀 메신저로 전달받은 값으로 채운다.
#         cp .env.sample .env
# 주의: VITE_ 접두사가 붙은 값은 빌드 시 클라이언트 번들에
#       그대로 노출된다. 여기에는 공개 가능한 값만 둘 것.
# =========================================================

VITE_API_BASE_URL=http://localhost:8080/api
# SockJS는 HTTP(S) URL 사용 (ws:// 아님). 비우면 VITE_API_BASE_URL 기준으로 /ws 자동 유도.
VITE_WS_BASE_URL=http://localhost:8080/ws

# 로컬 dev → 배포 백엔드 프록시 (설정 시 /api·/ws·/oauth2 가 이 주소로 전달됨)
# VITE_DEV_PROXY_TARGET=https://handdam.amitawhite.com

# Toss Payments 클라이언트(퍼블리셔블) 키 - 공개 가능
VITE_TOSS_CLIENT_KEY=
